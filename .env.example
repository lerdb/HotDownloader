# HotDownloader 独立服务配置示例
# 复制为仓库根目录的 .env，修改登录密码后运行 docker compose up -d。
# 完整说明：crates/hotdownloader-server/README.md

# ── 访问认证 ──────────────────────────────────────────────
# 用户名和密码必须同时设置；用户名不能包含冒号。
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-your-own-password

# 可选：改用令牌认证时，将上面两个值都置空，再填写至少 16 个字符的令牌。
# 同时配置账号密码和令牌时，服务只接受账号密码。
HOTDOWNLOADER_TOKEN=

# ── 下载目录 ──────────────────────────────────────────────
# Compose 挂载源：默认使用命名卷，也可改为宿主机绝对路径，如 /srv/music。
# 此变量由 compose.yaml 使用，不是服务进程的配置项。
HOTDOWNLOADER_DOWNLOAD_MOUNT=hotdownloader-downloads

# 容器内的下载目录，必须为绝对路径；Compose 会同步设置挂载目标。
HOTDOWNLOADER_DOWNLOAD_DIR=/downloads

# ── NAS 挂载保护 ───────────────────────────────────────────
# 可选：下载盘内预先创建的普通标记文件，相对于下载目录，如 .hotdownloader-mounted。
# 启用前先在实际挂载盘内创建文件；服务不会自动创建标记。
# 留空时，扫描通过文件数量骤减保护识别异常。
HOTDOWNLOADER_DOWNLOAD_MOUNT_MARKER=

# ── 已有音乐库 ────────────────────────────────────────────
# 附加扫描目录的 JSON 数组；下载目录已自动纳入扫描。
# path 使用容器内绝对路径，须同时在 compose.yaml 的 volumes 中添加挂载。
HOTDOWNLOADER_SCAN_DIRS=[]

# 配置示例：用下面这一行替换上面的空数组。
# HOTDOWNLOADER_SCAN_DIRS=[{"path":"/music/archive","template":"{song} - {artist}","artistSeparator":"、","mountMarker":".hotdownloader-mounted"}]
# 对应的 Compose 只读挂载：/srv/music/archive:/music/archive:ro
# template 可省略，此时只读取音频标签；artistSeparator 默认是“、”。
# mountMarker 可省略；配置后必须在对应挂载盘内预先创建标记文件。

# ── 其他服务参数（按需启用）────────────────────────────────
# 以下参数尚未由仓库的 compose.yaml 转发。
# 使用 Compose 时，需在 services.hotdownloader.environment 中显式添加对应项。
# 使用 docker run --env-file .env 时，已取消注释的参数会直接传给容器。
# 本机运行需将变量设置到进程环境中；服务不会自动读取 .env 文件。

# 日志级别：off、error、warn、info、debug、trace；默认 info。
# HOTDOWNLOADER_LOG_LEVEL=info

# 下列值与镜像默认配置一致；调整目录时也需同步调整挂载。
# 本机默认分别为 127.0.0.1:8787、./data、./dist。
# 容器内需监听 0.0.0.0:8787，才能通过现有端口映射访问。
# HOTDOWNLOADER_BIND=0.0.0.0:8787
# HOTDOWNLOADER_DATA_DIR=/data
# HOTDOWNLOADER_WEB_DIR=/app/dist
