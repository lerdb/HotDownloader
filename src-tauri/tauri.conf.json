{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "HotDownloader",
  "version": "1.1.2",
  "identifier": "lerd.hotdownloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "HotDownloader",
        "width": 1600,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "跨平台音乐下载器",
    "longDescription": "基于 Tauri 2 + Vue 3 的跨平台音乐下载工具，支持桌面端（Windows/macOS/Linux）与 Android 端，提供搜索、歌单导入、多任务下载、自动降级、音频解密等功能。",
    "resources": [
      "../LICENSE",
      "../NOTICE"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
